--- a/ai/tests/test_analyzer.py
+++ b/ai/tests/test_analyzer.py
@@ -11,0 +12 @@
+    "type_match": "matched",
@@ -156,0 +158,37 @@
+
+
+@pytest.mark.parametrize("match", ["mismatch", "uncertain"])
+def test_unconfirmed_type_cannot_assign_signs_to_selected_component(match):
+    result = make_analyzer(lambda r: reply(dict(GOOD, type_match=match))).analyze(
+        sharp_image(), "electric_motor", "Двигатель")
+    assert result.category == "check_recommended"
+    assert result.signs == [] and result.assessment_confidence == 0
+    assert "тип узла" in result.explanation
+    assert "Уточнить выбор" in result.recommendation
+    assert result.image_quality == "ok"
+    assert "type_match" not in result.as_dict()
+
+
+@pytest.mark.parametrize("value", [None, True, [], {}, "yes", "", 1])
+def test_invalid_internal_type_check_is_not_confirmation(value):
+    calls = []
+    def handler(request):
+        calls.append(1)
+        return reply(dict(GOOD, type_match=value))
+    result = make_analyzer(handler).analyze(sharp_image(), "flange", "Фланец")
+    assert len(calls) == 2
+    assert result.explanation == "Автоматический анализ не выполнен."
+    assert result.signs == []
+
+
+def test_missing_internal_type_check_retries_then_falls_back():
+    answer = {key: value for key, value in GOOD.items() if key != "type_match"}
+    result = make_analyzer(lambda r: reply(answer)).analyze(sharp_image(), "flange", "Фланец")
+    assert result.explanation == "Автоматический анализ не выполнен."
+
+
+def test_poor_visibility_takes_precedence_over_type_mismatch():
+    answer = dict(GOOD, type_match="mismatch", image_quality="poor", explanation="На снимке узел закрыт.")
+    result = make_analyzer(lambda r: reply(answer)).analyze(sharp_image(), "flange", "Фланец")
+    assert result.category == "check_recommended" and result.image_quality == "poor"
+    assert result.signs == [] and "закрыт" in result.explanation
